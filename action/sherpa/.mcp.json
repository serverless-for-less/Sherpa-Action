{
    "mcpServers": {
        "next-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "next-devtools-mcp@latest"
            ]
        },
        "cloudflare-docs": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://docs.mcp.cloudflare.com/mcp"
            ]
        },
        "cloudflare": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://bindings.mcp.cloudflare.com/mcp"
            ]
        }
    }
}